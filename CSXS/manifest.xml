<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="9.0" ExtensionBundleId="com.savizstudio.photoshop.plugin.1.0.dev"
    ExtensionBundleVersion="1.0.0" ExtensionBundleName="Savior Jordani Studio PS Plugin (CEP DEV)"
    xmlns:ExtensionBundleId="http://ns.adobe.com/extension">
    <ExtensionList>
        <Extension Id="com.savizstudio.photoshop.plugin.1.0.dev.panel" Version="1.0.0" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <Host Name="PHXS" Version="[24.0,99.9]" />
            <Host Name="PHSP" Version="[24.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.savizstudio.photoshop.plugin.1.0.dev.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./jsx/hostscript.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                        <Parameter>--disable-gpu</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Savior Jordani Studio</Menu>
                    <Geometry>
                        <Size>
                            <Height>600</Height>
                            <Width>300</Width>
                        </Size>
                        <MinSize>
                            <Height>400</Height>
                            <Width>280</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>1200</Height>
                            <Width>600</Width>
                        </MaxSize>
                    </Geometry>
                    <Icons>
                        <Icon Type="Normal">./icons/darkPlugin.png</Icon>
                        <Icon Type="RollOver">./icons/darkPlugin.png</Icon>
                        <Icon Type="Disabled">./icons/darkPlugin.png</Icon>
                        <Icon Type="DarkNormal">./icons/darkPlugin.png</Icon>
                        <Icon Type="DarkRollOver">./icons/darkPlugin.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
